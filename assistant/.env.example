# imp-assistant configuration
# Copy to .env, fill in values, then load into your shell:
#   set -a; source .env; set +a
# (the assistant reads environment variables only; it does not load .env itself.)

# --- Required: Telegram ---

# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to talk to the bot. Single owner by
# design; messages from anyone else are ignored. Find your id via @userinfobot.
IMP_TG_ALLOWED_USER_IDS=

# --- Required: model provider (OpenRouter) ---

# OpenRouter API key (the assistant pins the OpenRouter base URL itself).
OPENAI_API_KEY=

# --- Optional: model ---

#OPENAI_MODEL=gpt-5-mini
#IMP_REASONING_EFFORT=medium

# --- Optional: speech-to-text (voice notes) ---

# Model used to transcribe voice notes via OpenRouter's audio endpoint.
#IMP_STT_MODEL=openai/whisper-large-v3-turbo

# --- Optional: owner timezone ---

# Resolves at_local wall times in schedule_job (e.g. "2026-09-24 08:00").
# Must be a valid IANA name. (default: Asia/Almaty)
#IMP_TZ=Asia/Almaty

# Brave Search API key, enables the web_search tool (default: unset)
#BRAVE_API_KEY=

# --- Optional: assistant home ---

# Assistant home directory; also the filesystem sandbox root. Holds AGENTS.md,
# skills/, sessions/, scratch/, scripts/, outbox/, jobs/, inbox/, state.json.
# (default: ~/assistant)
#IMP_HOME=~/assistant

# --- Optional: Telegram rendering ---

# Minimum seconds between status-message edits (debounce). (default: 2.5)
#IMP_TG_EDIT_INTERVAL=2.5

# Max characters in the status message; oldest lines are dropped past this.
# Telegram's hard message limit is 4096. (default: 3500)
#IMP_TG_STATUS_MAX_CHARS=3500

# --- Optional: session lifecycle ---

# Start a fresh session before a turn once context usage reaches this fraction
# of IMP_MAX_CONTEXT. (default: 0.85)
#IMP_SESSION_RESET_THRESHOLD=0.85

# --- Optional: housekeeping ---

# Delete files in scratch/ older than this many days. (default: 7)
#IMP_SCRATCH_TTL_DAYS=7

# --- Optional: agent limits (reused from imp) ---

#IMP_MAX_ITERATIONS=50
#IMP_MAX_CONTEXT=128000
#IMP_COMMAND_TIMEOUT=180
#IMP_NETWORK_TIMEOUT=360
#IMP_MAX_TOOL_OUTPUT=100000
#IMP_MAX_HTTP_BYTES=10000000