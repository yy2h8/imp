# systemd unit — generic Linux
#
# Install:
#   1. Repo checkout at /opt/imp; install uv at /usr/local/bin/uv and run
#      `cd /opt/imp && uv sync --locked --no-dev` (see assistant/README.md).
#   2. Copy assistant/.env.example to /etc/assistant.env, fill it in, then:
#        chmod 600 /etc/assistant.env
#   3. cp assistant/deploy/assistant.service /etc/systemd/system/
#      systemctl daemon-reload && systemctl enable --now assistant
#
# Logs: journalctl -u assistant -f

[Unit]
Description=imp-assistant: personal assistant over Telegram (imp library)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/uv run --locked --no-sync python -m assistant
WorkingDirectory=/opt/imp
EnvironmentFile=/etc/assistant.env
Restart=on-failure
RestartSec=5

# The agent runs shell commands as root by design.
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
