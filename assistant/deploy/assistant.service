# systemd unit — generic Linux
#
# Install:
#   1. Repo checkout at /opt/imp, venv at /opt/imp-venv (see assistant/README.md).
#   2. Create assistant account/home (see README), then env file at /etc/assistant.env (copy assistant/.env.example and fill it in):
#        chmod 600 /etc/assistant.env && chown assistant:assistant /etc/assistant.env
#   3. cp assistant/deploy/assistant.service /etc/systemd/system/
#      systemctl daemon-reload && systemctl enable --now assistant
#
# Logs: journalctl -u assistant -f

[Unit]
Description=imp-assistant: personal assistant over Telegram (imp library)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=assistant
Group=assistant
ExecStart=/opt/imp-venv/bin/python -m assistant
WorkingDirectory=/opt/imp
EnvironmentFile=/etc/assistant.env
Restart=on-failure
RestartSec=5

# The agent runs shell commands by design; keep the service user-scoped.
# IMP_HOME (default ~/assistant) must be writable by this user.
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
