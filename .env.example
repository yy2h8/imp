# imp configuration
# Copy to .env, fill in values, then load into your shell:
#   set -a; source .env; set +a
# (imp reads environment variables only; it does not load .env itself.)

# --- Required ---

# API key for your OpenAI-compatible provider.
OPENAI_API_KEY=

# --- Optional: provider ---

# Model name (default: gpt-5-mini)
#OPENAI_MODEL=gpt-5-mini

# OpenAI-compatible API base URL (default: https://api.openai.com/v1)
#OPENAI_BASE_URL=https://api.openai.com/v1

# Reasoning effort for reasoning models: none, minimal, low, medium, high,
# xhigh, or max. Unset = provider default (no reasoning-specific params sent).
#IMP_REASONING_EFFORT=medium

# Brave Search API key, enables the web_search tool (default: unset)
#BRAVE_API_KEY=

# --- Optional: agent behavior ---

# Workspace root directory, absolute or relative (default: .)
#IMP_WORKSPACE=.

# Max ReAct iterations per turn (default: 50)
#IMP_MAX_ITERATIONS=50

# Max estimated context size in tokens (default: 128000)
#IMP_MAX_CONTEXT=128000

# --- Optional: limits ---

# Shell command timeout in seconds (default: 180)
#IMP_COMMAND_TIMEOUT=180

# HTTP request timeout in seconds (default: 360)
#IMP_NETWORK_TIMEOUT=360

# Max tool output size in chars (default: 100000)
#IMP_MAX_TOOL_OUTPUT=100000

# Max tool output lines shown in the UI (default: 10)
#IMP_MAX_TOOL_DISPLAY_LINES=10

# Max reasoning lines shown in the UI, keeping the last lines
# (default: 10)
#IMP_MAX_REASONING_DISPLAY_LINES=10

# Max HTTP response size in bytes (default: 10000000)
#IMP_MAX_HTTP_BYTES=10000000

# Auto-approve tool calls without asking (1/true/yes/on; default: unset).
# Can also be enabled with the CLI -y/--yes flag.
#IMP_AUTO_APPROVE=0
